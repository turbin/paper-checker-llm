# 这是一个.env文件的示例，请按照此格式填写您的环境变量
# 每一行必须是 KEY=VALUE 格式
# 不要有单独的URL或不符合格式的内容

# OpenAI API设置
OPENAI_API_KEY=sk-your-api-key-here
# API基础URL，如果使用自定义代理或服务，取消下面一行的注释并修改URL
# OPENAI_API_BASE=https://api.openai.com/v1

# 应用设置
DEBUG=True
LOG_LEVEL=INFO

# 默认的模型设置
DEFAULT_MODEL=gpt-4

# 其他可选设置
# TIMEOUT=60
# MAX_TOKENS=4000